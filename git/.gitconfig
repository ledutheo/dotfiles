[user]
	name = ledutheo
	email = theoledu@muslim.com

[init]
	defaultBranch = main

[core]
	editor = nano
	autocrlf = false
	safecrlf = true
	excludesFile = ~/.gitignore_global

[commit]
	gpgsign = false

[pull]
	rebase = true

[push]
	autoSetupRemote = true
	default = simple

[fetch]
	prune = true

[alias]
	# Pretty logs
	lg  = log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit
	lga = log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit --all

	# Status & diff
	s   = status -s
	d   = diff
	dc  = diff --cached
	ds  = diff --staged

	# Commit shortcuts
	c   = commit -m
	ca  = commit -am
	amend = commit --amend --no-edit

	# Branch & checkout
	co  = checkout
	cb  = checkout -b
	br  = branch -vv
	bd  = branch -d

	# Stash
	st  = stash
	sp  = stash pop

	# Undo & reset
	undo = reset --soft HEAD~1
	hard = reset --hard HEAD~1

	# Remote
	r  = remote -v

	# Last commit message
	last = log -1 --pretty=%B

[credential]
	helper = cache --timeout=3600

[diff]
	tool = vimdiff

[merge]
	tool = vimdiff
